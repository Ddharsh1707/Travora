# Copy to .env.local for local development. Never commit real values.
# Everything prefixed VITE_ is PUBLIC: it is copied into the browser bundle.

# "legacy" = existing Spring Boot login (default). "supabase" = Supabase Auth.
VITE_AUTH_PROVIDER=legacy

# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=
# The anon / publishable key ONLY. The app refuses to start with a service-role key.
VITE_SUPABASE_ANON_KEY=

# Legacy Spring Boot API (only used while VITE_AUTH_PROVIDER=legacy)
VITE_API_BASE_URL=

# Server-side secrets do NOT go here. Set them with:
#   supabase secrets set ALLOWED_ORIGINS=https://travora-ashy.vercel.app INVITE_REDIRECT_URL=https://travora-ashy.vercel.app/login
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions by Supabase automatically.
